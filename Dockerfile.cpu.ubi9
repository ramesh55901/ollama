# CPU-only UBI9 Dockerfile generated from Ollama v0.32.0 original
ARG CMAKEVERSION=3.31.2
ARG NINJAVERSION=1.12.1

FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS base
ARG CMAKEVERSION=3.31.2
ARG NINJAVERSION=1.12.1
USER 0
RUN dnf install -y \
    ca-certificates wget git unzip tar gzip xz findutils which make python3 \
    clang llvm libomp libomp-devel openblas-devel dnf-plugins-core \
 && dnf clean all && rm -rf /var/cache/dnf
RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v${CMAKEVERSION}/cmake-${CMAKEVERSION}-linux-x86_64.tar.gz | tar xz -C /usr/local --strip-components 1
RUN curl -fsSL -o /tmp/ninja.zip https://github.com/ninja-build/ninja/releases/download/v${NINJAVERSION}/ninja-linux.zip \
 && unzip /tmp/ninja.zip -d /usr/local/bin && rm -f /tmp/ninja.zip
ENV CMAKE_GENERATOR=Ninja
ENV CC=clang
ENV CXX=clang++
ENV LDFLAGS=-s

FROM base AS llama-server-cpu
WORKDIR /go/src/github.com/ollama/ollama
COPY LLAMA_CPP_VERSION .
COPY llama/server llama/server
COPY llama/compat llama/compat
RUN --mount=type=cache,target=/root/.ccache \
    cmake -S llama/server --preset cpu \
    && cmake --build build/llama-server-cpu -- -l $(nproc) \
    && cmake --install build/llama-server-cpu --component llama-server --strip \
    && for lib in /usr/lib64/libomp.so* /usr/lib64/libgomp.so*; do \
         [ -e "$lib" ] && cp -a "$lib" dist/lib/ollama/ || true; \
       done

FROM base AS build
WORKDIR /go/src/github.com/ollama/ollama
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=1
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildmode=pie -o /bin/ollama .

FROM scratch AS image-archive
COPY --from=build /bin/ollama /bin/ollama
COPY --from=llama-server-cpu /go/src/github.com/ollama/ollama/dist/lib/ollama /lib/ollama

FROM registry.access.redhat.com/ubi9/ubi:9.8-1782841664
RUN dnf install -y ca-certificates openblas \
 && dnf clean all && rm -rf /var/cache/dnf
COPY --from=image-archive /bin /usr/bin
COPY --from=image-archive /lib/ollama /usr/lib/ollama
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
